<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER_LEFT" prefHeight="724.0" prefWidth="744.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.proyectocrud.controller.ProductosController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Label text="Gestión de productos">
         <font>
            <Font name="System Bold" size="14.0" />
         </font></Label>
      <GridPane hgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="149.0" minWidth="10.0" prefWidth="63.99999237060547" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="286.00000762939453" minWidth="10.0" prefWidth="230.39999999999998" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="123.0" minWidth="10.0" prefWidth="96.39999999999998" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="212.0" minWidth="10.0" prefWidth="210.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Codigo:" />
            <Label text="Precio:" GridPane.rowIndex="1" />
            <Label text="Categoría:" GridPane.rowIndex="2" />
            <Label text="Fecha creación:" GridPane.rowIndex="3" />
            <TextField fx:id="txtCodigo" GridPane.columnIndex="1" />
            <TextField fx:id="txtPrecio" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Nombre:" GridPane.columnIndex="2" />
            <Label text="Stock:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Label text="Marca:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <Label text="Descripción:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <TextField fx:id="txtNombre" promptText="Nombre del producto" GridPane.columnIndex="3" />
            <TextField fx:id="txtStock" promptText="0" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <TextField fx:id="txtDescripcion" promptText="Descripción opcional" GridPane.columnIndex="3" GridPane.rowIndex="3" />
            <ComboBox fx:id="cmbDescripcion" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbMarca" prefWidth="150.0" GridPane.columnIndex="3" GridPane.rowIndex="2" />
            <DatePicker fx:id="dtpFechaCreacion" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <HBox prefHeight="33.0" prefWidth="620.0" spacing="15.0">
         <children>
            <Button fx:id="btnNuevo" mnemonicParsing="false" onAction="#nuevoProducto" text="Nuevo" />
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarProducto" text="Guardar" />
            <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizarProducto" text="Actualizar" />
            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarProducto" text="Eliminar" />
         </children>
      </HBox>
      <Separator prefWidth="200.0" />
      <Label text="Búsqueda y filtros">
         <font>
            <Font size="14.0" />
         </font></Label>
      <GridPane hgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="170.0" minWidth="10.0" prefWidth="102.2" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="285.0" minWidth="10.0" prefWidth="259.6" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="143.99999999999994" minWidth="10.0" prefWidth="87.0" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="242.0" minWidth="10.0" prefWidth="217.39999999999998" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Código o nombre:" />
            <Label text="Desde:" GridPane.rowIndex="1" />
            <Label text="Precio mínimo:" GridPane.rowIndex="2" />
            <Label text="Categoría:" GridPane.columnIndex="2" />
            <Label text="Ordenar por:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <Label text="Hasta:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Label text="Precio máximo:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <TextField fx:id="txtCodigoNombre" promptText="Buscar..." GridPane.columnIndex="1" />
            <TextField fx:id="txtPrecioMinimo" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="txtPrecioMaximo" GridPane.columnIndex="3" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbCategoria" prefWidth="150.0" GridPane.columnIndex="3" />
            <ComboBox fx:id="cmbOrdenarPor" prefWidth="150.0" GridPane.columnIndex="3" GridPane.rowIndex="3" />
            <DatePicker fx:id="dtpFechaHasta" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <DatePicker fx:id="dtpFechaDesde" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <CheckBox fx:id="chkProductosExistentes" mnemonicParsing="false" text="Solo productos con existencias" GridPane.columnIndex="1" GridPane.rowIndex="3" />
         </children>
      </GridPane>
      <HBox prefHeight="25.0" prefWidth="704.0" spacing="15.0">
         <children>
            <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#buscarProductos" text="Buscar" />
            <Button fx:id="btnLimpiarFiltros" mnemonicParsing="false" onAction="#limpiarFiltros" text="Limpiar filtros" />
         </children>
      </HBox>
      <TableView prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="colCodigo" prefWidth="112.19999885559082" text="Código" />
          <TableColumn fx:id="colNombre" prefWidth="92.40000915527344" text="Nombre" />
            <TableColumn fx:id="colCategoria" prefWidth="85.60000610351562" text="Categoría" />
            <TableColumn fx:id="colMarca" prefWidth="75.20001220703125" text="Marca" />
            <TableColumn fx:id="colPrecio" prefWidth="68.20001220703125" text="Precio" />
            <TableColumn fx:id="colStock" prefWidth="84.39999389648438" text="Stock" />
            <TableColumn fx:id="colFechaCreacion" minWidth="6.20001220703125" prefWidth="117.5999755859375" text="Fecha creación" />
        </columns>
      </TableView>
   </children>
</VBox>
